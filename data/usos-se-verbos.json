[{"id":"u:reflexivo","v":"Reflexivo","cat":"Os usos do se","kind":"uso","pt":"a ação volta para quem faz","ex":"se lava las manos","note":"Cabe “a sí mismo”.","base":"","base_pt":"","n":130},{"id":"u:reciproco","v":"Recíproco","cat":"Os usos do se","kind":"uso","pt":"um ao outro (só plural)","ex":"se abrazan","note":"Cabe “el uno al otro”.","base":"","base_pt":"","n":70},{"id":"u:pronominal","v":"Pronominal","cat":"Os usos do se","kind":"uso","pt":"o verbo exige o pronome","ex":"se arrepiente / se va","note":"“A sí mismo” não funciona; o verbo exige ou muda com o pronome.","base":"","base_pt":"","n":61},{"id":"u:espontaneo","v":"Mudança espontânea","cat":"Os usos do se","kind":"uso","pt":"algo acontece sozinho","ex":"la puerta se abrió","note":"Algo mudou de estado sem causador.","base":"","base_pt":"","n":129},{"id":"u:acidental","v":"Acidental","cat":"Os usos do se","kind":"uso","pt":"aconteceu sem querer","ex":"se me cayó el vaso","note":"Tem me/te/le… logo depois do se e algo aconteceu sem querer.","base":"","base_pt":"","n":317},{"id":"u:enfase","v":"Ênfase","cat":"Os usos do se","kind":"uso","pt":"“tudo, até o fim”","ex":"se comió la pizza","note":"Dá para tirar o se e o sentido continua, só mais fraco.","base":"","base_pt":"","n":31},{"id":"u:pasivo","v":"Passivo","cat":"Os usos do se","kind":"uso","pt":"algo é feito, sem dizer por quem","ex":"se venden casas","note":"Uma coisa sofre a ação e o verbo concorda com ela.","base":"","base_pt":"","n":120},{"id":"u:impersonal","v":"Impessoal","cat":"Os usos do se","kind":"uso","pt":"“a gente”, “as pessoas”","ex":"se vive bien aquí","note":"Sem sujeito, verbo sempre no singular.","base":"","base_pt":"","n":68},{"id":"u:lele","v":"No lugar de le/les","cat":"Os usos do se","kind":"uso","pt":"evita “le lo”","ex":"se lo di","note":"Vem antes de lo/la/los/las e substitui le/les.","base":"","base_pt":"","n":72},{"id":"u:sesi","v":"Se, sé, si, sí","cat":"Os usos do se","kind":"uso","pt":"quatro palavras diferentes","ex":"n